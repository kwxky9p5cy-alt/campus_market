# Public browser configuration. The anon key is safe to expose only together with RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Requests fail with a recoverable error after this duration (1000-60000 ms).
VITE_REQUEST_TIMEOUT_MS=12000

# Server-only variables for supabase/functions/ai-assistant.
# Set these as Supabase Edge Function secrets. Never prefix a secret with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
