# Public browser configuration. The anon key is safe to expose only together with RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Vision + web research can involve multiple upstream requests.
VITE_REQUEST_TIMEOUT_MS=30000

# Server-only variables for supabase/functions/ai-assistant.
# Set these as Supabase Edge Function secrets. Never prefix a secret with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional. Enables cited web research and reference pricing.
TAVILY_API_KEY=
